# Environment
APP_ENV=dev

# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fatman
POSTGRES_PASSWORD=fatman_dev_password
POSTGRES_DB=fatman
DATABASE_URL=postgres://fatman:fatman_dev_password@localhost:5432/fatman?sslmode=disable

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fatman_redis_dev_password
REDIS_ADDR=localhost:6379

# Mailpit (Local Dev SMTP + Web Inbox)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@fatman.local
MAILPIT_UI_PORT=8025

# Go API Server
API_HOST=0.0.0.0
API_PORT=8180
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-in-production-32bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=336h
OTP_HMAC_SECRET=change-me-to-a-long-random-otp-hmac-secret-32bytes
OTP_TTL=10m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
COOKIE_SECURE=false

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8180
NEXT_PUBLIC_WS_URL=ws://localhost:8180/ws
